{
  "rule_profile": "default-v1",
  "contract_version": "0.1.0",
  "status": "draft_not_runtime_validated",
  "description": "Relation family, cycle handling and impact propagation are derived from relation_type here. These values must not be duplicated and manually edited on every edge.",
  "default_policy": {
    "unknown_relation_type": "block_publish_and_report",
    "missing_relation_rule": "block_publish_and_report",
    "untracked_cycle": "warn_unless_rule_marks_cycle_forbidden",
    "evidence_claim_without_source": "warn_in_draft_block_publish_for_critical_claim"
  },
  "relations": {
    "contains": {
      "family": "structure",
      "meaning": "source contains target as a component or child",
      "directed": true,
      "symmetric": false,
      "cycle_policy": "forbidden",
      "impact": {
        "source_changed": "forward_direct",
        "target_changed": "reverse_direct"
      },
      "condition_requirement": "none"
    },
    "depends_on": {
      "family": "dependency",
      "meaning": "source requires target to be available or valid",
      "directed": true,
      "symmetric": false,
      "cycle_policy": "forbidden",
      "impact": {
        "source_changed": "none",
        "target_changed": "reverse_transitive"
      },
      "condition_requirement": "none"
    },
    "precedes": {
      "family": "sequence",
      "meaning": "source must occur before target",
      "directed": true,
      "symmetric": false,
      "cycle_policy": "forbidden",
      "impact": {
        "source_changed": "forward_direct",
        "target_changed": "reverse_direct"
      },
      "condition_requirement": "none"
    },
    "causes": {
      "family": "causal_claim",
      "meaning": "source is claimed to cause target",
      "directed": true,
      "symmetric": false,
      "cycle_policy": "allowed",
      "impact": {
        "source_changed": "forward_advisory",
        "target_changed": "none"
      },
      "condition_requirement": "claim_and_evidence_status_required_when_asserted_as_fact"
    },
    "influences": {
      "family": "influence_claim",
      "meaning": "source is claimed to influence target without asserting deterministic causation",
      "directed": true,
      "symmetric": false,
      "cycle_policy": "allowed",
      "impact": {
        "source_changed": "forward_advisory",
        "target_changed": "none"
      },
      "condition_requirement": "claim_and_evidence_status_required_when_asserted_as_fact"
    },
    "triggers": {
      "family": "control",
      "meaning": "source event or condition initiates target behavior",
      "directed": true,
      "symmetric": false,
      "cycle_policy": "warn",
      "impact": {
        "source_changed": "forward_direct",
        "target_changed": "none"
      },
      "condition_requirement": "guard_or_start_condition_recommended"
    },
    "transfers_data_to": {
      "family": "dataflow",
      "meaning": "source provides data or a data artifact to target",
      "directed": true,
      "symmetric": false,
      "cycle_policy": "warn",
      "impact": {
        "source_changed": "forward_direct",
        "target_changed": "reverse_direct"
      },
      "condition_requirement": "none"
    },
    "conflicts_with": {
      "family": "conflict",
      "meaning": "source and target are incompatible under a stated scope or rule",
      "directed": false,
      "symmetric": true,
      "cycle_policy": "allowed",
      "impact": {
        "source_changed": "both_direct",
        "target_changed": "both_direct"
      },
      "condition_requirement": "description_required"
    },
    "supersedes": {
      "family": "lifecycle",
      "meaning": "source replaces target for a stated scope",
      "directed": true,
      "symmetric": false,
      "cycle_policy": "forbidden",
      "impact": {
        "source_changed": "forward_direct",
        "target_changed": "reverse_direct"
      },
      "condition_requirement": "scope_or_reason_recommended"
    },
    "explains": {
      "family": "explanation",
      "meaning": "source is an explanation or explanatory view of target",
      "directed": true,
      "symmetric": false,
      "cycle_policy": "allowed",
      "impact": {
        "source_changed": "forward_advisory",
        "target_changed": "none"
      },
      "condition_requirement": "none"
    },
    "supports": {
      "family": "justification",
      "meaning": "source provides a rationale or support for target",
      "directed": true,
      "symmetric": false,
      "cycle_policy": "allowed",
      "impact": {
        "source_changed": "forward_direct",
        "target_changed": "reverse_advisory"
      },
      "condition_requirement": "provenance_required_for_critical_claims"
    },
    "implements": {
      "family": "implementation_trace",
      "meaning": "source implements target",
      "directed": true,
      "symmetric": false,
      "cycle_policy": "allowed",
      "impact": {
        "source_changed": "forward_advisory",
        "target_changed": "reverse_direct"
      },
      "condition_requirement": "none"
    },
    "derived_from": {
      "family": "derivation",
      "meaning": "source was derived from target",
      "directed": true,
      "symmetric": false,
      "cycle_policy": "forbidden",
      "impact": {
        "source_changed": "none",
        "target_changed": "reverse_direct"
      },
      "condition_requirement": "provenance_required"
    },
    "satisfies": {
      "family": "requirement_trace",
      "meaning": "source satisfies target requirement or acceptance criterion",
      "directed": true,
      "symmetric": false,
      "cycle_policy": "allowed",
      "impact": {
        "source_changed": "forward_direct",
        "target_changed": "reverse_direct"
      },
      "condition_requirement": "none"
    },
    "verified_by": {
      "family": "verification_trace",
      "meaning": "source requirement or claim is verified by target test or evidence item",
      "directed": true,
      "symmetric": false,
      "cycle_policy": "allowed",
      "impact": {
        "source_changed": "forward_direct",
        "target_changed": "reverse_direct"
      },
      "condition_requirement": "verification_result_must_be_recorded_separately"
    },
    "is_evidence_for": {
      "family": "evidence_trace",
      "meaning": "source is evidence used to evaluate target claim",
      "directed": true,
      "symmetric": false,
      "cycle_policy": "allowed",
      "impact": {
        "source_changed": "forward_direct",
        "target_changed": "reverse_direct"
      },
      "condition_requirement": "source_node_with_nonempty_provenance_required; target_node_must_be_claim_bearing; edge expresses an evidence-for/support relationship but does not auto-set target evidence_status"
    },
    "refutes": {
      "family": "evidence_trace",
      "meaning": "source evidence proposition contradicts or materially weakens the target claim; direction is from evidence proposition to target claim",
      "directed": true,
      "symmetric": false,
      "cycle_policy": "allowed",
      "impact": {
        "source_changed": "forward_direct",
        "target_changed": "reverse_direct"
      },
      "condition_requirement": "source_node_with_nonempty_provenance_required; target_node_must_be_claim_bearing; must not auto-set target evidence_status"
    }
  },
  "implementation_notes": [
    "relation_type is the only relation-kind field stored on an edge; family and behavior are derived from this registry.",
    "Do not store family or impact policy redundantly on each edge unless a reviewed, scoped override mechanism is later required.",
    "The first implementation must validate source_id and target_id existence, unique edge IDs, self-loop rules and cycle policy in code; JSON Schema cannot enforce these cross-array graph constraints.",
    "These default policies are draft design decisions and require table-top review before implementation. They are not test results."
  ]
}
